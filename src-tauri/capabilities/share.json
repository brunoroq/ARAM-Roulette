{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "share-build",
  "description": "Copy build images and save them only to a user-selected file.",
  "windows": ["main"],
  "permissions": [
    "core:image:allow-from-bytes",
    "core:resources:allow-close",
    "clipboard-manager:allow-write-image",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
